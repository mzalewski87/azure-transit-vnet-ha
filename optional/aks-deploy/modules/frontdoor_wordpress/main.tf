###############################################################################
# Front Door + External LB Rule Module
#
# Two things, both touching EXISTING root-module resources via data sources:
#
#   1. New AFD endpoint + origin group + origin + route under the existing
#      afd-panos-transit profile. Pattern mirrors modules/frontdoor/main.tf
#      with s/Apache/WordPress/ and s/origin-external-lb/origin-aks-wordpress/.
#      The endpoint hostname is autogenerated (`wordpress-XXXX.z01.azurefd.net`).
#
#   2. A NEW LB rule on the existing External LB for port 8080. The existing
#      LB rule set covers 80 (Apache HTTP) and 443 (Apache HTTPS); we add
#      8080 so AFD can forward WordPress traffic to a distinct backend port
#      that PAN-OS DNAT maps to the AKS ingress IP. enable_floating_ip=true
#      mirrors the existing rules — without it the PAN-OS DNAT rule cannot
#      match on the original destination IP.
#
# Caveat: adding a rule to an existing LB via data source is a touch of
# shared-state ownership. terraform destroy on this optional module removes
# ONLY the rule we added, not the LB itself. The blast radius is intentional:
# we're extending a shared resource rather than recreating it.
###############################################################################

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.100"
    }
  }
}

###############################################################################
# Data sources — existing AFD profile + External LB
###############################################################################

data "azurerm_cdn_frontdoor_profile" "main" {
  name                = var.frontdoor_profile_name
  resource_group_name = var.frontdoor_resource_group_name
}

data "azurerm_lb" "external" {
  name                = var.external_lb_name
  resource_group_name = var.external_lb_resource_group_name
}

data "azurerm_lb_backend_address_pool" "external" {
  name            = "bep-external-panos"
  loadbalancer_id = data.azurerm_lb.external.id
}

###############################################################################
# Dedicated health probe for the WordPress rule
#
# azurerm provider has NO `azurerm_lb_probe` data source, so we cannot reuse
# the existing `probe-fw-https` from the root module. Instead we create a
# new probe with identical settings (HTTPS 443 /php/login.php → FW
# management plane). This is functionally equivalent — FW returns 200 the
# same way to both probes — and `terraform destroy` on this module cleanly
# removes only OUR probe without touching the root module's.
###############################################################################

resource "azurerm_lb_probe" "wordpress" {
  name                = "probe-fw-https-wordpress"
  loadbalancer_id     = data.azurerm_lb.external.id
  protocol            = "Https"
  port                = 443
  request_path        = "/php/login.php"
  interval_in_seconds = 5
  number_of_probes    = 2
}

###############################################################################
# New LB rule on the existing External LB — TCP 8080
###############################################################################

resource "azurerm_lb_rule" "wordpress_8080" {
  name                           = "rule-http-8080-wordpress"
  loadbalancer_id                = data.azurerm_lb.external.id
  protocol                       = "Tcp"
  frontend_port                  = var.wordpress_origin_port
  backend_port                   = var.wordpress_origin_port
  frontend_ip_configuration_name = "fe-external-lb"
  backend_address_pool_ids       = [data.azurerm_lb_backend_address_pool.external.id]
  probe_id                       = azurerm_lb_probe.wordpress.id
  # CRITICAL — matches the existing 80/443 rules. Without floating IP the
  # PAN-OS DNAT rule (DNAT-Inbound-WordPress) cannot match on External-LB-PIP.
  enable_floating_ip      = true
  idle_timeout_in_minutes = 4
  load_distribution       = "Default"
  disable_outbound_snat   = true
}

###############################################################################
# AFD — new endpoint + origin group + origin + route
###############################################################################

resource "azurerm_cdn_frontdoor_endpoint" "wordpress" {
  name                     = var.endpoint_name
  cdn_frontdoor_profile_id = data.azurerm_cdn_frontdoor_profile.main.id
  enabled                  = true
  tags                     = var.tags
}

resource "azurerm_cdn_frontdoor_origin_group" "wordpress" {
  name                     = "og-aks-wordpress"
  cdn_frontdoor_profile_id = data.azurerm_cdn_frontdoor_profile.main.id
  session_affinity_enabled = false

  health_probe {
    interval_in_seconds = var.health_probe_interval_seconds
    path                = var.health_probe_path
    protocol            = "Http"
    request_type        = "HEAD"
  }

  load_balancing {
    additional_latency_in_milliseconds = 50
    sample_size                        = 4
    successful_samples_required        = 3
  }
}

# Origin = the existing External LB on port 8080. AFD forwards HTTP to this
# host:port; the LB hits the FW which DNATs to the AKS ingress.
resource "azurerm_cdn_frontdoor_origin" "wordpress" {
  name                          = "origin-aks-wordpress-8080"
  cdn_frontdoor_origin_group_id = azurerm_cdn_frontdoor_origin_group.wordpress.id
  enabled                       = true

  certificate_name_check_enabled = false

  host_name          = var.external_lb_public_ip
  http_port          = var.wordpress_origin_port
  https_port         = 443
  origin_host_header = var.external_lb_public_ip
  priority           = 1
  weight             = 1000

  depends_on = [azurerm_lb_rule.wordpress_8080]
}

resource "azurerm_cdn_frontdoor_route" "wordpress" {
  name                          = "route-wordpress"
  cdn_frontdoor_endpoint_id     = azurerm_cdn_frontdoor_endpoint.wordpress.id
  cdn_frontdoor_origin_group_id = azurerm_cdn_frontdoor_origin_group.wordpress.id
  cdn_frontdoor_origin_ids      = [azurerm_cdn_frontdoor_origin.wordpress.id]

  enabled                = true
  forwarding_protocol    = "HttpOnly" # AFD→Origin: HTTP 8080 (no SSL backend); AFD terminates TLS to client
  https_redirect_enabled = true       # HTTP client redirected to HTTPS at AFD edge
  patterns_to_match      = ["/*"]
  supported_protocols    = ["Http", "Https"]

  cache {
    query_string_caching_behavior = "IgnoreQueryString"
    compression_enabled           = false
  }

  depends_on = [azurerm_cdn_frontdoor_origin.wordpress]
}
